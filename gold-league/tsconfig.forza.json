{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/forza/**/*.ts",
    "src/forza/**/*.vue",
    "src/ui-kit/**/*.ts",
    "src/ui-kit/**/*.vue"
  ]
}
