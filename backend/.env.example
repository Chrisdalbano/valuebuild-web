# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# Environment
ENVIRONMENT=development

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini AI (effect valuation + research digest). Server-side only — NEVER expose
# to the frontend or commit a real value. AI features no-op gracefully if unset.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# AI_CURATED_LIMIT=80
# AI_CALL_DELAY_SECONDS=4

# Optional. When set, POST /api/items/refresh and POST /api/ai/refresh require
# this value in an X-Admin-Token header.
ADMIN_TOKEN=

# Teamfight Tactics match review (GET /api/tft/review). Optional: without both
# values the route answers "needs_key" and the page explains what is missing.
# Server-side only. Never expose to the frontend or commit a real value.
# The review is of this one account; there is no player search.
# Do not set these on the public backend until BuildValue has a production key
# and Riot Sign On (see docs/tft/RIOT-API-AND-POLICY.md).
RIOT_API_KEY=
TFT_REVIEW_RIOT_ID=
# Optional regional host for account and match data: americas, europe, asia, sea
# TFT_REVIEW_REGION=americas
